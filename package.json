{
  "name": "superapp",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "android": "npm run --workspace=@superapp/host android",
    "ios": "npm run --workspace=@superapp/host ios",
    "start": "npm run --workspace=@superapp/host start",
    "lint": "eslint .",
    "test": "jest",
    "nx:graph": "nx graph",
    "nx:host:start": "nx run superapp-host:start",
    "nx:host:ios": "nx run superapp-host:ios",
    "nx:host:android": "nx run superapp-host:android",
    "nx:components:build": "nx run nebula-components:build",
    "nx:miniapp:start": "nx run sample-miniapp:start",
    "nx:miniapp:bundle-ios": "nx run sample-miniapp:bundle-ios",
    "sample:start": "npm run --workspace=superapp-sample-miniapp start",
    "sample:bundle:ios": "react-native bundle --config packages/sample-miniapp/metro.config.js --platform ios --dev false --entry-file index.js --bundle-output packages/sample-miniapp/build/main.jsbundle --assets-dest packages/sample-miniapp/build"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-native": "0.83.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.83.1",
    "@react-native/eslint-config": "0.83.1",
    "@react-native/metro-config": "0.83.1",
    "@react-native/typescript-config": "0.83.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.6.3",
    "prettier": "^3.3.3",
    "react-test-renderer": "19.2.0",
    "typescript": "^5.8.3",
    "nx": "22.5.4"
  },
  "engines": {
    "node": ">=20"
  },
  "nx": {}
}
