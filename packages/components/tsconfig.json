{
  "extends": "../../tsconfig.root.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "jsx": "react-native",
    "lib": ["ES2015", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "types", "types/jsx-compat.d.ts"],
  "exclude": ["src/__tests__/**"]
}
