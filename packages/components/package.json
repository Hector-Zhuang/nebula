{
  "name": "@nebula/components",
  "version": "4.1.12-alpha.4",
  "description": "React Native 基础组件",
  "author": "O2Team",
  "license": "MIT",
  "main": "./src/index.ts",
  "scripts": {
    "prod": "pnpm run build",
    "assets": "cpy 'src/**/*.png' '!src/__tests__/*' dist",
    "prebuild": "pnpm run clean",
    "clean": "rimraf ./dist",
    "build": "tsc && pnpm run assets",
    "dev": "pnpm run assets && tsc --watch",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "test": "jest --silent",
    "test:ci": "jest --ci -i --coverage --silent",
    "test:dev": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "files": [
    "src",
    "types"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NervJS/taro.git"
  },
  "keywords": [
    "taro"
  ],
  "engines": {
    "node": ">= 18"
  },
  "dependencies": {
    "@react-native-picker/picker": "2.6.1",
    "@ant-design/react-native": "5.0.0",
    "prop-types": "^15.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/preset-env": "^7.24.4",
    "@react-native/babel-preset": "^0.73.18",
    "@testing-library/jest-native": "^5.4.2",
    "@testing-library/react-native": "^12.4.1",
    "cpy-cli": "^5.0.0",
    "dpdm": "^3.14.0",
    "expo-module-scripts": "^3.5.1",
    "jest-expo": "~50.0.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.73"
  }
}
