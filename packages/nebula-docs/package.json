{
  "name": "@nebula-rn/docs",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Nebula documentation site",
  "author": "Hector Zhuang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hector-Zhuang/nebula.git"
  },
  "scripts": {
    "build": "next build && npm run sync:algolia",
    "dev": "next dev",
    "start": "next start",
    "sync:algolia": "node ./scripts/sync-content.mjs",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "algoliasearch": "^5.40.0",
    "fumadocs-core": "16.7.14",
    "fumadocs-mdx": "14.2.13",
    "fumadocs-ui": "16.7.14",
    "lucide-react": "^1.8.0",
    "mermaid": "^11.14.0",
    "next": "16.2.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.9",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2"
  }
}
